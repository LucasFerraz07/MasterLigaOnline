# Controle de versão e metadados de ferramentas.
.git
.gitignore
.gitattributes
.github

# Dependências instaladas localmente: a imagem cria as de produção.
vendor
node_modules

# Segredos e configurações locais: serão definidos no Coolify.
.env
.env.*

# Caches e artefatos gerados na máquina local.
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
.phpunit.result.cache
.phpunit.cache
_ide_helper.php

# Assets gerados pelo frontend e links públicos locais.
public/build
public/hot
public/storage

# Arquivos de desenvolvimento e documentação.
coverage
tests
docs
phpunit.xml
README.md
.editorconfig
.npmrc
.idea
.vscode
.zed
.cursor
.codex
.nova
npm-debug.log*
pnpm-debug.log*

# Arquivos usados apenas durante a construção da imagem.
Dockerfile
.dockerignore
